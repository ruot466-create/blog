---
// Giscus 评论组件 —— 基于 GitHub Discussions
// 配置来源：https://giscus.app
const REPO = "ruot466-create/blog";
const REPO_ID = "R_kgDOVEXOrg";
const CATEGORY = "Announcements";
const CATEGORY_ID = "DIC_kwDOVEXOrs4DHjZx";
---

<div id="giscus-wrap" class="card-base z-10 rounded-[var(--radius-large)] px-6 md:px-9 py-6 mb-4">
    <div class="flex items-center gap-2 mb-4">
        <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2m-2 12H6v-2h12zm0-3H6V9h12zm0-3H6V6h12z"/></svg>
        </div>
        <div class="font-bold text-black/90 dark:text-white/90">评论</div>
    </div>
    <div class="text-sm text-black/40 dark:text-white/40 mb-5">
        需要 GitHub 账号登录才能评论；评论对所有人可见。
    </div>
    <script
        src="https://giscus.app/client.js"
        data-repo={REPO}
        data-repo-id={REPO_ID}
        data-category={CATEGORY}
        data-category-id={CATEGORY_ID}
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="preferred_color_scheme"
        data-lang="zh-CN"
        data-loading="lazy"
        crossorigin="anonymous"
        async
        is:inline
    ></script>
</div>
