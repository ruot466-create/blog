---
// 侧边栏迷你播放器：常驻侧边栏，支持多曲目
---

<div id="mini-player" class="card-base p-3">
    <div class="flex items-center gap-3 mb-3">
        <div class="mp-disc w-10 h-10 rounded-full shrink-0 flex items-center justify-center bg-[var(--btn-regular-bg)]">
            <span class="mp-disc-note text-[0.95rem] text-[var(--btn-content)]">♪</span>
        </div>
        <div class="min-w-0 flex-1">
            <div id="mp-title" class="text-sm font-bold truncate leading-tight">—</div>
            <div id="mp-artist" class="text-[0.68rem] text-neutral-400 truncate leading-tight">—</div>
        </div>
    </div>

    <div id="mp-bar" class="w-full h-1.5 rounded-full bg-[var(--btn-regular-bg)] cursor-pointer relative mb-1.5">
        <div id="mp-fill" class="h-full rounded-full bg-[var(--primary)]" style="width:0%"></div>
    </div>

    <div class="flex justify-between text-[0.68rem] text-neutral-400 mb-3">
        <span id="mp-now">0:00</span>
        <span id="mp-dur">0:00</span>
    </div>

    <div class="flex items-center justify-center gap-1">
        <button id="mp-prev" aria-label="上一首" title="上一首"
            class="btn-regular w-8 h-8 rounded-full active:scale-90 transition flex items-center justify-center">
            <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 fill-[var(--btn-content)]">
                <path d="M7 5h2v14H7zM19 5v14l-9-7z"/>
            </svg>
        </button>
        <button id="mp-toggle" aria-label="播放或暂停" title="播放 / 暂停"
            class="btn-regular w-11 h-11 rounded-full active:scale-90 transition flex items-center justify-center mx-1">
            <svg id="mp-icon-play" viewBox="0 0 24 24" class="w-4 h-4 fill-[var(--btn-content)]">
                <path d="M8 5v14l11-7z"/>
            </svg>
            <svg id="mp-icon-pause" viewBox="0 0 24 24" class="w-4 h-4 fill-[var(--btn-content)] hidden">
                <path d="M7 5h4v14H7zM13 5h4v14h-4z"/>
            </svg>
        </button>
        <button id="mp-next" aria-label="下一首" title="下一首"
            class="btn-regular w-8 h-8 rounded-full active:scale-90 transition flex items-center justify-center">
            <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 fill-[var(--btn-content)]">
                <path d="M15 5h2v14h-2zM5 5l9 7-9 7z"/>
            </svg>
        </button>
    </div>

    <div id="mp-hint" class="hidden text-[0.68rem] text-neutral-400 mt-3 text-center">
        浏览器禁止自动播放，点 ▶ 开始
    </div>
</div>

<audio id="mp-audio" preload="metadata"></audio>

<style>
    .mp-disc { transition: transform 0.3s ease; }
    .mp-disc.spinning { animation: mp-spin 3.5s linear infinite; }
    @keyframes mp-spin { to { transform: rotate(360deg); } }
</style>

<script>
    /* ============================================================
       曲目列表 —— 加歌就在这里加一行
       1) 音频文件放进  blog/public/audio/
       2) 在数组里加一行，src 写 /audio/你的文件名.mp3
       ============================================================ */
    const TRACKS = [
        { title: "桜流し", artist: "宇多田ヒカル", src: "/audio/sakura-nagashi.mp3" },
        { title: "in the pool", artist: "kensuke ushio", src: "/audio/in-the-pool.mp3" },
        { title: "Color Your Night", artist: "Lotus Juice / 高橋あず美", src: "/audio/color-your-night.mp3" },
        { title: "The Way We Were", artist: "山本剛", src: "/audio/the-way-we-were.mp3" },
    ];

    const audio = document.querySelector<HTMLAudioElement & { __mpInited?: boolean }>("#mp-audio");
    const toggle = document.getElementById("mp-toggle");
    const prev = document.getElementById("mp-prev");
    const next = document.getElementById("mp-next");
    const iconPlay = document.getElementById("mp-icon-play");
    const iconPause = document.getElementById("mp-icon-pause");
    const bar = document.getElementById("mp-bar");
    const fill = document.getElementById("mp-fill");
    const now = document.getElementById("mp-now");
    const dur = document.getElementById("mp-dur");
    const hint = document.getElementById("mp-hint");
    const titleEl = document.getElementById("mp-title");
    const artistEl = document.getElementById("mp-artist");
    const disc = document.querySelector(".mp-disc");

    let index = 0;

    function fmt(sec: number) {
        if (!isFinite(sec)) return "0:00";
        const m = Math.floor(sec / 60);
        const s = Math.floor(sec % 60);
        return m + ":" + (s < 10 ? "0" : "") + s;
    }

    function showPlaying(playing: boolean) {
        iconPlay?.classList.toggle("hidden", playing);
        iconPause?.classList.toggle("hidden", !playing);
        disc?.classList.toggle("spinning", playing);
    }

    function load(i: number, autoplay: boolean) {
        if (!audio || !TRACKS.length) return;
        index = (i + TRACKS.length) % TRACKS.length;
        const t = TRACKS[index];
        audio.src = t.src;
        if (titleEl) titleEl.textContent = t.title;
        if (artistEl) artistEl.textContent = t.artist;
        if (dur) dur.textContent = "0:00";
        if (now) now.textContent = "0:00";
        if (fill) fill.style.width = "0%";
        if (autoplay) {
            const p = audio.play();
            if (p && p.catch) p.catch(function () { hint?.classList.remove("hidden"); });
        }
    }

    if (audio && TRACKS.length && !audio.__mpInited) {
        // Swup 换页会重跑本脚本：同一个 <audio> 元素只初始化一次，
        // 否则 load(0) 会把播放进度和当前曲目重置回第一首
        audio.__mpInited = true;
        audio.volume = 0.6;
        load(0, false);

        audio.addEventListener("loadedmetadata", function () {
            if (dur) dur.textContent = fmt(audio.duration);
        });
        audio.addEventListener("timeupdate", function () {
            const p = audio.duration ? (audio.currentTime / audio.duration) * 100 : 0;
            if (fill) fill.style.width = p + "%";
            if (now) now.textContent = fmt(audio.currentTime);
        });
        audio.addEventListener("play", function () { showPlaying(true); hint?.classList.add("hidden"); });
        audio.addEventListener("pause", function () { showPlaying(false); });
        audio.addEventListener("ended", function () { load(index + 1, true); });

        toggle?.addEventListener("click", function () {
            if (audio.paused) audio.play(); else audio.pause();
        });
        prev?.addEventListener("click", function () { load(index - 1, true); });
        next?.addEventListener("click", function () { load(index + 1, true); });
        bar?.addEventListener("click", function (e) {
            const rect = bar.getBoundingClientRect();
            const ratio = (e.clientX - rect.left) / rect.width;
            if (audio.duration) audio.currentTime = ratio * audio.duration;
        });

        const attempt = audio.play();
        if (attempt && attempt.catch) {
            attempt.catch(function () { hint?.classList.remove("hidden"); });
        }
    }
</script>
