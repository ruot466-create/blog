---
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout title="吉他" description="在浏览器里拨响一把吉他">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-6 md:px-9 py-7 relative w-full">
            <h1 class="text-3xl font-bold mb-2">拨一下试试</h1>
            <p class="text-sm text-neutral-400 mb-7">
                点琴弦发声，或者<strong>按住鼠标从左往右划过去</strong>（扫弦）。标准调弦 E A D G B E。
            </p>

            <div class="relative">
                <div id="guitar-strings" class="flex flex-col gap-5 py-4 select-none touch-none"></div>
                <canvas id="guitar-particles" class="absolute inset-0 w-full h-full pointer-events-none"></canvas>
            </div>

            <div class="mt-7 pt-6 border-t border-dashed border-[var(--line-divider)]">
                <div class="font-bold text-lg mb-1">音色</div>
                <p class="text-xs text-neutral-400 mb-4">换一种拾音方式，声音立刻不一样</p>
                <div id="guitar-tones" class="flex flex-wrap gap-2"></div>
                <canvas id="guitar-vis" height="90" class="w-full mt-5 rounded-xl bg-[var(--btn-regular-bg)]"></canvas>
            </div>

            <div class="mt-9 pt-7 border-t border-dashed border-[var(--line-divider)]">
                <div class="font-bold text-lg mb-1">和弦</div>
                <p class="text-xs text-neutral-400 mb-4">点一下 = 从低音弦扫到高音弦</p>
                <div id="guitar-chords" class="flex flex-wrap gap-2"></div>
                <div id="guitar-shape" class="mt-5 flex justify-center"></div>
                <p class="text-xs text-neutral-400 mt-2 text-center">点上面的和弦 → 看指法</p>
            </div>

            <div class="mt-9 pt-7 border-t border-dashed border-[var(--line-divider)]">
                <div class="font-bold text-lg mb-1">音阶</div>
                <p class="text-xs text-neutral-400 mb-4">指板上标出音阶位置，练 solo 用</p>
                <div id="guitar-scales" class="flex flex-wrap gap-2 mb-3"></div>
                <p class="text-xs text-neutral-400 mb-4">点指板上的任意音 → 听它的声音</p>
                <div id="guitar-fretboard" class="overflow-x-auto"></div>
            </div>

            <div class="mt-7 pt-6 border-t border-dashed border-[var(--line-divider)]">
                <div class="font-bold text-lg mb-1">和弦伴奏 / 转换练习</div>
                <p class="text-xs text-neutral-400 mb-4">
                    自动循环播放一个和弦进行，你跟着弹。把「每和弦拍数」调小就是转换练习。
                </p>

                <div class="flex flex-col gap-4">
                    <div>
                        <div class="text-xs text-neutral-400 mb-2">和弦进行</div>
                        <div id="prog-presets" class="flex flex-wrap gap-2"></div>
                    </div>
                    <div>
                        <div class="text-xs text-neutral-400 mb-2">每和弦拍数（越小越像转换练习）</div>
                        <div id="prog-beats" class="flex flex-wrap gap-2"></div>
                    </div>
                    <div class="flex items-center gap-4 flex-wrap">
                        <button id="prog-toggle"
                            class="btn-regular h-10 px-5 rounded-lg font-bold active:scale-95 transition text-[var(--btn-content)]">开始</button>
                        <div class="flex items-center gap-3 flex-1 min-w-[180px]">
                            <input id="prog-bpm" type="range" min="40" max="180" value="70"
                                class="flex-1 h-1.5 accent-[var(--primary)]" aria-label="速度">
                            <span id="prog-bpm-value" class="text-sm font-bold w-20 text-right">70 BPM</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-5">
                        <div id="prog-current" class="text-3xl font-bold text-[var(--primary)] w-20 text-center">—</div>
                        <div id="prog-shape" class="flex-1 flex justify-center"></div>
                    </div>
                </div>
            </div>

            <div class="mt-7 pt-6 border-t border-dashed border-[var(--line-divider)]">
                <div class="font-bold text-lg mb-1">节拍器</div>
                <p class="text-xs text-neutral-400 mb-4">练琴用，速度可调</p>
                <div class="flex items-center gap-4 flex-wrap mb-4">
                    <button id="metro-toggle"
                        class="btn-regular h-10 px-5 rounded-lg font-bold active:scale-95 transition text-[var(--btn-content)]">开始</button>
                    <div class="flex items-center gap-3 flex-1 min-w-[200px]">
                        <input id="metro-bpm" type="range" min="40" max="200" value="90"
                            class="flex-1 h-1.5 accent-[var(--primary)]" aria-label="速度">
                        <span id="metro-value" class="text-sm font-bold w-20 text-right">90 BPM</span>
                    </div>
                    <div id="metro-dot" class="w-3.5 h-3.5 rounded-full bg-[var(--btn-regular-bg)] transition"></div>
                </div>
                <div class="flex items-center gap-4 flex-wrap">
                    <div id="metro-meters" class="flex gap-2"></div>
                    <label class="flex items-center gap-2 text-sm text-neutral-500 cursor-pointer select-none">
                        <input id="metro-accel" type="checkbox" class="accent-[var(--primary)]">
                        渐快（每 8 拍 +4）
                    </label>
                    <span id="metro-beat" class="text-xs text-neutral-400 ml-auto">第 1 / 4 拍</span>
                </div>
            </div>
        </div>
    </div>

    <style is:global>
        .guitar-string {
            display: flex; align-items: center; gap: 0.9rem;
            width: 100%; background: none; border: 0; padding: 0.35rem 0;
            cursor: pointer; -webkit-tap-highlight-color: transparent;
        }
        .guitar-note {
            width: 2.2rem; flex: none; font-size: 0.72rem; letter-spacing: 0.05em;
            color: oklch(0.6 0.05 var(--hue, 145)); text-align: right;
            font-family: ui-monospace, monospace;
        }
        .guitar-line {
            flex: 1; border-radius: 999px;
            background: linear-gradient(90deg,
                oklch(0.72 0.06 var(--hue, 145)),
                oklch(0.55 0.04 var(--hue, 145)) 50%,
                oklch(0.72 0.06 var(--hue, 145)));
            transition: filter 0.15s ease, transform 0.05s ease;
        }
        .guitar-string:hover .guitar-line { filter: brightness(1.35); }
        .guitar-string.sounding .guitar-line {
            animation: guitar-vibrate 0.4s ease-out;
            box-shadow: 0 0 14px oklch(0.7 0.15 var(--hue, 145));
        }
        @keyframes guitar-vibrate {
            0%   { transform: translateY(-2px) scaleY(2.2); filter: brightness(1.9); }
            35%  { transform: translateY(1.5px) scaleY(1.4); }
            70%  { transform: translateY(-0.8px) scaleY(1.1); }
            100% { transform: translateY(0) scaleY(1); }
        }
        .chord-btn {
            padding: 0.45rem 0.95rem; border-radius: 0.6rem;
            background: var(--btn-regular-bg); color: var(--btn-content);
            font-weight: 700; font-size: 0.9rem; border: 0; cursor: pointer;
            transition: transform 0.1s ease, background 0.15s ease;
        }
        .chord-btn:hover { background: var(--btn-regular-bg-hover); }
        .chord-btn:active { transform: scale(0.94); background: var(--btn-regular-bg-active); }
        .metro-hit { background: var(--primary) !important; transform: scale(1.5); }
        .tone-btn {
            padding: 0.4rem 0.9rem; border-radius: 0.6rem; border: 0; cursor: pointer;
            background: var(--btn-regular-bg); color: var(--btn-content);
            font-size: 0.85rem; font-weight: 700;
            transition: transform 0.1s ease, background 0.15s ease;
        }
        .tone-btn:hover { background: var(--btn-regular-bg-hover); }
        .tone-btn:active { transform: scale(0.94); }
        .tone-btn.active { background: var(--primary); color: white; }
        .scale-btn {
            padding: 0.35rem 0.8rem; border-radius: 0.6rem; border: 0; cursor: pointer;
            background: var(--btn-regular-bg); color: var(--btn-content);
            font-size: 0.82rem; font-weight: 700; transition: transform 0.1s ease;
        }
        .scale-btn:active { transform: scale(0.94); }
        .scale-btn.active { background: var(--primary); color: white; }
        .prog-btn {
            padding: 0.35rem 0.8rem; border-radius: 0.6rem; border: 0; cursor: pointer;
            background: var(--btn-regular-bg); color: var(--btn-content);
            font-size: 0.82rem; font-weight: 700; transition: transform 0.1s ease;
        }
        .prog-btn:active { transform: scale(0.94); }
        .prog-btn.active { background: var(--primary); color: white; }
        #prog-current.beat { animation: prog-pop 0.18s ease-out; }
        @keyframes prog-pop { 0% { transform: scale(1.25); } 100% { transform: scale(1); } }
    </style>

    <script>
        const TUNING = [
            { note: "E2", freq: 82.41,  gauge: 5 },
            { note: "A2", freq: 110.0,  gauge: 4.4 },
            { note: "D3", freq: 146.83, gauge: 3.8 },
            { note: "G3", freq: 196.0,  gauge: 3.2 },
            { note: "B3", freq: 246.94, gauge: 2.6 },
            { note: "E4", freq: 329.63, gauge: 2.0 },
        ];

        // 常用和弦：从低音弦到高音弦的组成音
        const CHORDS = {
            "C":    [130.81, 164.81, 196.0, 261.63],
            "G":    [98.0, 123.47, 146.83, 196.0],
            "Am":   [110.0, 130.81, 164.81, 220.0],
            "Em":   [82.41, 98.0, 123.47, 164.81],
            "Dm":   [146.83, 174.61, 220.0, 293.66],
            "F":    [87.31, 110.0, 130.81, 174.61],
            "D":    [146.83, 185.0, 220.0, 293.66],
            "E":    [82.41, 123.47, 164.81, 207.65],
            "A":    [110.0, 138.59, 164.81, 220.0],
            "G7":   [98.0, 123.47, 146.83, 174.61],
            "Cadd9": [130.81, 164.81, 196.0, 293.66],
            "Am7":  [110.0, 130.81, 164.81, 196.0],
        };

        let audioCtx = null;
        let analyser = null;
        let currentTone = "acoustic";

        function getCtx() {
            if (!audioCtx) {
                const Ctor = window.AudioContext || window.webkitAudioContext;
                if (!Ctor) return null;
                audioCtx = new Ctor();
                analyser = audioCtx.createAnalyser();
                analyser.fftSize = 512;
                analyser.smoothingTimeConstant = 0.75;
                analyser.connect(audioCtx.destination);
            }
            if (audioCtx.state === "suspended") audioCtx.resume();
            return audioCtx;
        }

        // 输出口：有 analyser 就经过它（可视化需要），否则直连
        function out(ac) { return analyser || ac.destination; }

        // 失真曲线
        function distortionCurve(amount) {
            const n = 1024, curve = new Float32Array(n), k = amount;
            for (let i = 0; i < n; i++) {
                const x = (i * 2) / n - 1;
                curve[i] = ((3 + k) * x * 20 * Math.PI / 180) / (Math.PI + k * Math.abs(x));
            }
            return curve;
        }

        // 按当前音色处理一段声音，返回输出节点
        function applyTone(ac, input) {
            let node = input;
            if (currentTone === "nylon") {
                const lp = ac.createBiquadFilter();
                lp.type = "lowpass";
                lp.frequency.value = 1800;
                lp.Q.value = 0.7;
                node.connect(lp); node = lp;
                const lp2 = ac.createBiquadFilter();
                lp2.type = "lowpass";
                lp2.frequency.value = 3200;
                node.connect(lp2); node = lp2;
            } else if (currentTone === "clean") {
                const hp = ac.createBiquadFilter();
                hp.type = "highpass";
                hp.frequency.value = 120;
                node.connect(hp); node = hp;
                const peak = ac.createBiquadFilter();
                peak.type = "peaking";
                peak.frequency.value = 2500;
                peak.gain.value = 5;
                node.connect(peak); node = peak;
            } else if (currentTone === "distortion") {
                const pre = ac.createGain();
                pre.gain.value = 3.2;
                node.connect(pre);
                const shaper = ac.createWaveShaper();
                shaper.curve = distortionCurve(60);
                shaper.oversample = "4x";
                pre.connect(shaper);
                const lp = ac.createBiquadFilter();
                lp.type = "lowpass";
                lp.frequency.value = 3200;
                shaper.connect(lp); node = lp;
            }
            return node;
        }

        // Karplus-Strong：噪声激励 + 延迟线平均滤波，物理建模拨弦
        function pluck(freq, velocity, delay) {
            const ac = getCtx();
            if (!ac) return;
            const sr = ac.sampleRate;
            const period = Math.max(2, Math.round(sr / freq));
            const length = Math.round(sr * 2.2);
            const buffer = ac.createBuffer(1, length, sr);
            const data = buffer.getChannelData(0);
            for (let i = 0; i < period; i++) data[i] = Math.random() * 2 - 1;
            const decay = 0.9965;
            for (let i = period; i < length; i++) {
                data[i] = (data[i - period] + data[i - period + 1]) * 0.5 * decay;
            }
            const src = ac.createBufferSource();
            src.buffer = buffer;
            const gain = ac.createGain();
            const v = velocity === undefined ? 1 : velocity;
            gain.gain.value = (currentTone === "distortion" ? 0.16 : 0.32) * v;
            src.connect(gain);
            const tail = applyTone(ac, gain);
            tail.connect(out(ac));
            src.start(ac.currentTime + (delay || 0));
        }

        // ---- 琴弦 ----
        const wrap = document.getElementById("guitar-strings");
        const nodes = [];
        function flash(node) {
            node.el.classList.remove("sounding");
            void node.el.offsetWidth;
            node.el.classList.add("sounding");
        }
        if (wrap) {
            TUNING.forEach(function (s) {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "guitar-string";
                btn.setAttribute("aria-label", "拨响 " + s.note + " 弦");
                const note = document.createElement("span");
                note.className = "guitar-note";
                note.textContent = s.note;
                const line = document.createElement("span");
                line.className = "guitar-line";
                line.style.height = s.gauge + "px";
                btn.appendChild(note);
                btn.appendChild(line);
                wrap.appendChild(btn);
                nodes.push({ el: btn, freq: s.freq, touched: false });
            });

            function strike(node, velocity) {
                pluck(node.freq, velocity, 0);
                flash(node);
                const pt = pointOf(node.el);
                if (pt) spawnParticles(pt.x, pt.y, 14);
            }

            nodes.forEach(function (node) {
                node.el.addEventListener("pointerdown", function (e) {
                    e.preventDefault();
                    nodes.forEach(function (n) { n.touched = false; });
                    node.touched = true;
                    strike(node, 1);
                });
                node.el.addEventListener("pointerenter", function (e) {
                    if (e.buttons !== 1 || node.touched) return;
                    node.touched = true;
                    strike(node, 0.75);
                });
            });
            document.addEventListener("pointerup", function () {
                nodes.forEach(function (n) { n.touched = false; });
            });
        }

        // ---- 和弦 ----
        const chordWrap = document.getElementById("guitar-chords");
        if (chordWrap) {
            Object.keys(CHORDS).forEach(function (name) {
                const b = document.createElement("button");
                b.type = "button";
                b.className = "chord-btn";
                b.textContent = name;
                b.addEventListener("click", function () {
                    const notes = CHORDS[name];
                    notes.forEach(function (f, i) { pluck(f, 0.9, i * 0.045); });
                    // 让对应的弦也抖一下
                    nodes.forEach(function (n, i) {
                        if (i < notes.length) {
                            setTimeout(function () {
                                flash(n);
                                const pt = pointOf(n.el);
                                if (pt) spawnParticles(pt.x, pt.y, 8);
                            }, i * 45);
                        }
                    });
                    drawShape(name);
                });
                chordWrap.appendChild(b);
            });
        }

        // ---- 拨弦粒子 ----
        const pcanvas = document.getElementById("guitar-particles");
        let pctx = null;
        let particleList = [];

        function initParticles() {
            if (!pcanvas) return;
            pctx = pcanvas.getContext("2d");
            function resize() {
                const r = pcanvas.getBoundingClientRect();
                const dpr = window.devicePixelRatio || 1;
                pcanvas.width = r.width * dpr;
                pcanvas.height = r.height * dpr;
                pctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            }
            resize();
            window.addEventListener("resize", resize);
            (function loop() {
                requestAnimationFrame(loop);
                if (!pctx) return;
                const r = pcanvas.getBoundingClientRect();
                pctx.clearRect(0, 0, r.width, r.height);
                if (!particleList.length) return;
                const hue = (getComputedStyle(document.documentElement).getPropertyValue("--hue").trim() || "145");
                particleList = particleList.filter(function (p) { return p.life > 0; });
                for (let i = 0; i < particleList.length; i++) {
                    const p = particleList[i];
                    p.x += p.vx;
                    p.y += p.vy;
                    p.vy += 0.06;
                    p.vx *= 0.99;
                    p.life -= 0.017;
                    if (p.life <= 0) continue;
                    pctx.globalAlpha = Math.max(0, p.life) * 0.9;
                    pctx.fillStyle = "oklch(0.72 0.14 " + hue + ")";
                    pctx.beginPath();
                    pctx.arc(p.x, p.y, p.size * p.life + 0.6, 0, Math.PI * 2);
                    pctx.fill();
                }
                pctx.globalAlpha = 1;
            })();
        }

        function spawnParticles(x, y, count) {
            if (!pcanvas) return;
            for (let i = 0; i < count; i++) {
                particleList.push({
                    x: x,
                    y: y,
                    vx: (Math.random() - 0.5) * 2.6,
                    vy: -Math.random() * 2.2 - 0.4,
                    size: Math.random() * 2.6 + 1.2,
                    life: 1,
                });
            }
        }

        // 计算某元素在粒子画布中的位置
        function pointOf(elem) {
            if (!pcanvas || !elem) return null;
            const cr = pcanvas.getBoundingClientRect();
            const r = elem.getBoundingClientRect();
            return { x: r.left - cr.left + r.width / 2, y: r.top - cr.top + r.height / 2 };
        }

        initParticles();

        // ---- 和弦指法图 ----
        // 顺序：6弦 → 1弦；-1 表示不弹，0 表示空弦
        const SHAPES = {
            "C":     [-1, 3, 2, 0, 1, 0],
            "G":     [3, 2, 0, 0, 0, 3],
            "Am":    [-1, 0, 2, 2, 1, 0],
            "Em":    [0, 2, 2, 0, 0, 0],
            "Dm":    [-1, -1, 0, 2, 3, 1],
            "F":     [1, 3, 3, 2, 1, 1],
            "D":     [-1, -1, 0, 2, 3, 2],
            "E":     [0, 2, 2, 1, 0, 0],
            "A":     [-1, 0, 2, 2, 2, 0],
            "G7":    [3, 2, 0, 0, 0, 1],
            "Cadd9": [-1, 3, 2, 0, 3, 3],
            "Am7":   [-1, 0, 2, 0, 1, 0],
        };

        let shapeBox = document.getElementById("guitar-shape");

        function drawShape(name) {
            if (!shapeBox) return;
            const frets = SHAPES[name];
            if (!frets) { shapeBox.innerHTML = ""; return; }

            const played = frets.filter(function (v) { return v > 0; });
            const minF = played.length ? Math.min.apply(null, played) : 1;
            const maxF = played.length ? Math.max.apply(null, played) : 4;
            let start = Math.max(1, minF);
            if (maxF - start > 3) start = Math.max(1, maxF - 3);
            const rows = 4;

            const W = 150, H = 180;
            const left = 28, top = 34, sw = (W - left - 16) / 5, sh = (H - top - 24) / rows;

            let svg = '<svg width="' + W + '" height="' + H + '" viewBox="0 0 ' + W + " " + H + '">';
            // 弦
            for (let i = 0; i < 6; i++) {
                const x = left + i * sw;
                svg += '<line x1="' + x + '" y1="' + top + '" x2="' + x + '" y2="' + (top + rows * sh) + '" stroke="oklch(0.75 0.02 var(--hue,145))" stroke-width="' + (2.6 - i * 0.3) + '"/>';
            }
            // 品
            for (let r = 0; r <= rows; r++) {
                const y = top + r * sh;
                svg += '<line x1="' + left + '" y1="' + y + '" x2="' + (left + 5 * sw) + '" y2="' + y + '" stroke="oklch(0.75 0.02 var(--hue,145))" stroke-width="' + (r === 0 ? 4 : 1.5) + '"/>';
            }
            // 起始品位数字
            if (start > 1) {
                svg += '<text x="' + (left - 14) + '" y="' + (top + sh * 0.7) + '" font-size="11" fill="oklch(0.6 0.03 var(--hue,145))">' + start + '</text>';
            }
            // 按弦点 / 空弦 / 禁弹
            for (let i = 0; i < 6; i++) {
                const x = left + i * sw;
                const v = frets[i];
                if (v === -1) {
                    svg += '<text x="' + (x - 3) + '" y="' + (top - 8) + '" font-size="12" fill="oklch(0.6 0.03 var(--hue,145))">×</text>';
                } else if (v === 0) {
                    svg += '<circle cx="' + x + '" cy="' + (top - 14) + '" r="4.5" fill="none" stroke="oklch(0.6 0.1 var(--hue,145))" stroke-width="1.6"/>';
                } else {
                    const row = v - start;
                    if (row >= 0 && row < rows) {
                        const y = top + row * sh + sh / 2;
                        svg += '<circle cx="' + x + '" cy="' + y + '" r="7" fill="oklch(0.70 0.14 var(--hue,145))"/>';
                    }
                }
            }
            svg += '<text x="' + (W / 2) + '" y="' + (H - 4) + '" font-size="13" font-weight="700" text-anchor="middle" fill="oklch(0.55 0.1 var(--hue,145))">' + name + '</text>';
            svg += "</svg>";
            shapeBox.innerHTML = svg;
        }

        // ---- 音阶图 ----
        const OPEN_PC = [4, 9, 2, 7, 11, 4];   // E A D G B E
        const NOTE_NAMES = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];
        const SCALES = {
            "C 大调":     [0, 2, 4, 5, 7, 9, 11],
            "G 大调":     [7, 9, 11, 0, 2, 4, 6],
            "A 小调五声": [9, 0, 2, 4, 7],
            "C 大调五声": [0, 2, 4, 7, 9],
            "A 布鲁斯":   [9, 0, 2, 3, 4, 7],
            "E 小调五声": [4, 7, 9, 11, 2],
        };
        let currentScale = "C 大调";

        const fb = document.getElementById("guitar-fretboard");
        const scaleWrap = document.getElementById("guitar-scales");

        function drawFretboard() {
            if (!fb) return;
            const steps = SCALES[currentScale];
            const FRETS = 12;
            const cw = 46, ch = 30;
            const W = 40 + cw * FRETS;
            const H = 24 + ch * 6;

            let svg = '<svg width="' + W + '" height="' + H + '" viewBox="0 0 ' + W + " " + H + '">';
            // 品丝
            for (let f = 0; f <= FRETS; f++) {
                const x = 40 + f * cw;
                svg += '<line x1="' + x + '" y1="18" x2="' + x + '" y2="' + (18 + ch * 6) + '" stroke="oklch(0.86 0.01 var(--hue,145))" stroke-width="1"/>';
            }
            // 弦
            for (let i = 0; i < 6; i++) {
                const y = 18 + i * ch + ch / 2;
                svg += '<line x1="40" y1="' + y + '" x2="' + (40 + cw * FRETS) + '" y2="' + y + '" stroke="oklch(0.80 0.02 var(--hue,145))" stroke-width="' + (2.4 - i * 0.25) + '"/>';
            }
            // 品位数字
            for (let f = 1; f <= FRETS; f++) {
                svg += '<text x="' + (40 + f * cw - cw / 2) + '" y="12" font-size="10" text-anchor="middle" fill="oklch(0.65 0.03 var(--hue,145))">' + f + "</text>";
            }
            // 音
            for (let i = 0; i < 6; i++) {
                const y = 18 + i * ch + ch / 2;
                for (let f = 0; f <= FRETS; f++) {
                    const pc = (OPEN_PC[i] + f) % 12;
                    if (steps.indexOf(pc) === -1) continue;
                    const x = 40 + f * cw + cw / 2;
                    const isRoot = pc === steps[0];
                    svg += '<circle cx="' + x + '" cy="' + y + '" r="8" fill="' + (isRoot ? "oklch(0.62 0.15 var(--hue,145))" : "oklch(0.78 0.09 var(--hue,145))") + '"/>';
                    svg += '<text x="' + x + '" y="' + (y + 3.5) + '" font-size="9" text-anchor="middle" fill="' + (isRoot ? "white" : "oklch(0.30 0.03 var(--hue,145))") + '">' + NOTE_NAMES[pc] + "</text>";
                }
            }
            svg += "</svg>";
            fb.innerHTML = svg;

            // 点指板上的音 → 发声
            Array.prototype.forEach.call(fb.querySelectorAll(".fb-note"), function (g) {
                g.addEventListener("click", function () {
                    const fr = parseFloat(g.getAttribute("data-freq"));
                    if (fr) pluck(fr, 1, 0);
                });
            });
        }

        if (scaleWrap) {
            Object.keys(SCALES).forEach(function (name) {
                const b = document.createElement("button");
                b.type = "button";
                b.className = "scale-btn" + (name === currentScale ? " active" : "");
                b.textContent = name;
                b.addEventListener("click", function () {
                    currentScale = name;
                    Array.prototype.forEach.call(scaleWrap.children, function (c) { c.classList.remove("active"); });
                    b.classList.add("active");
                    drawFretboard();
                });
                scaleWrap.appendChild(b);
            });
        }

        // ---- 音色 ----
        const TONES = [
            { id: "acoustic",   label: "钢弦木吉他" },
            { id: "nylon",      label: "尼龙弦" },
            { id: "clean",      label: "电吉他清音" },
            { id: "distortion", label: "失真" },
        ];
        const toneWrap = document.getElementById("guitar-tones");
        if (toneWrap) {
            TONES.forEach(function (t) {
                const b = document.createElement("button");
                b.type = "button";
                b.className = "tone-btn" + (t.id === currentTone ? " active" : "");
                b.textContent = t.label;
                b.addEventListener("click", function () {
                    currentTone = t.id;
                    Array.prototype.forEach.call(toneWrap.children, function (c) { c.classList.remove("active"); });
                    b.classList.add("active");
                    const ac = getCtx();
                    if (ac) pluck(TUNING[4].freq, 0.9, 0);  // 试听一下
                });
                toneWrap.appendChild(b);
            });
        }

        // ---- 频谱可视化 ----
        const canvas = document.getElementById("guitar-vis");
        if (canvas) {
            const cctx = canvas.getContext("2d");
            function resize() {
                canvas.width = canvas.clientWidth * (window.devicePixelRatio || 1);
            }
            resize();
            window.addEventListener("resize", resize);

            function draw() {
                requestAnimationFrame(draw);
                if (!canvas.width) return;
                const w = canvas.width;
                const h = canvas.height;
                cctx.clearRect(0, 0, w, h);

                const bars = 48;
                const gap = 2;
                const bw = (w - gap * (bars - 1)) / bars;
                let data = null;
                if (analyser) {
                    data = new Uint8Array(analyser.frequencyBinCount);
                    analyser.getByteFrequencyData(data);
                }
                // 主题色
                const style = getComputedStyle(document.documentElement);
                const hue = style.getPropertyValue("--hue").trim() || "145";
                cctx.fillStyle = "oklch(0.70 0.14 " + hue + ")";

                for (let i = 0; i < bars; i++) {
                    let v = 0;
                    if (data) {
                        const idx = Math.floor(Math.pow(i / bars, 1.6) * (data.length * 0.55));
                        v = data[idx] / 255;
                    }
                    const bh = Math.max(2, v * h * 0.9);
                    const x = i * (bw + gap);
                    cctx.globalAlpha = 0.25 + v * 0.75;
                    cctx.beginPath();
                    cctx.roundRect(x, h - bh, bw, bh, 2);
                    cctx.fill();
                }
                cctx.globalAlpha = 1;
            }
            draw();
        }

        // ---- 节拍器 ----
        const metroBtn = document.getElementById("metro-toggle");
        const bpmInput = document.getElementById("metro-bpm");
        const bpmValue = document.getElementById("metro-value");
        const metroDot = document.getElementById("metro-dot");
        const METERS = { "4/4": 4, "3/4": 3, "6/8": 6, "2/4": 2 };
        let currentMeter = "4/4";
        let beatIndex = 0;
        let accelCounter = 0;
        let metroTimer = null;
        let metroOn = false;

        const meterWrap = document.getElementById("metro-meters");
        const accelBox = document.getElementById("metro-accel");
        const beatLabel = document.getElementById("metro-beat");

        function tick() {
            const ac = getCtx();
            if (!ac) return;
            const beats = METERS[currentMeter];
            const isDown = beatIndex % beats === 0;

            const osc = ac.createOscillator();
            const g = ac.createGain();
            osc.frequency.value = isDown ? 1600 : 1050;
            g.gain.setValueAtTime(isDown ? 0.34 : 0.18, ac.currentTime);
            g.gain.exponentialRampToValueAtTime(0.001, ac.currentTime + 0.06);
            osc.connect(g);
            g.connect(out(ac));
            osc.start();
            osc.stop(ac.currentTime + 0.07);

            if (isDown) {
                metroDot?.classList.add("metro-hit");
                setTimeout(function () { metroDot?.classList.remove("metro-hit"); }, 100);
            }
            if (beatLabel) beatLabel.textContent = "第 " + ((beatIndex % beats) + 1) + " / " + beats + " 拍";

            beatIndex++;

            // 渐快：每 8 拍 +4 BPM
            if (accelBox && accelBox.checked && bpmInput) {
                accelCounter++;
                if (accelCounter >= 8 * (beats / 4)) {
                    accelCounter = 0;
                    const next = Math.min(200, Number(bpmInput.value) + 4);
                    bpmInput.value = String(next);
                    if (bpmValue) bpmValue.textContent = next + " BPM";
                    restartTimer();
                }
            }
        }

        function restartTimer() {
            if (metroTimer) clearInterval(metroTimer);
            const bpm = Number(bpmInput?.value) || 90;
            metroTimer = setInterval(tick, 60000 / bpm);
        }

        function startMetro() {
            beatIndex = 0;
            accelCounter = 0;
            tick();
            restartTimer();
            metroOn = true;
            if (metroBtn) metroBtn.textContent = "停止";
        }

        function stopMetro() {
            if (metroTimer) clearInterval(metroTimer);
            metroTimer = null;
            metroOn = false;
            if (metroBtn) metroBtn.textContent = "开始";
            if (beatLabel) beatLabel.textContent = "已停止";
        }

        if (meterWrap) {
            Object.keys(METERS).forEach(function (m) {
                const b = document.createElement("button");
                b.type = "button";
                b.className = "scale-btn" + (m === currentMeter ? " active" : "");
                b.textContent = m;
                b.addEventListener("click", function () {
                    currentMeter = m;
                    beatIndex = 0;
                    Array.prototype.forEach.call(meterWrap.children, function (c) { c.classList.remove("active"); });
                    b.classList.add("active");
                });
                meterWrap.appendChild(b);
            });
        }

        metroBtn?.addEventListener("click", function () {
            if (metroOn) stopMetro(); else startMetro();
        });
        bpmInput?.addEventListener("input", function () {
            if (bpmValue) bpmValue.textContent = bpmInput.value + " BPM";
            if (metroOn) restartTimer();
        });

        // 首屏默认
        drawShape("C");
        drawFretboard();
    </script>
</MainGridLayout>
